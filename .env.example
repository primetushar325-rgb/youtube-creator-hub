# ============================================================
# Creator Hub — Environment Variables (server-side ONLY)
# ============================================================

# --- Cloudflare D1 (database) — REQUIRED for admin analytics ---
# 1. Create free D1 database at dash.cloudflare.com
# 2. Get these 3 values (see guide below)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# --- Admin login ---
# A secret string used to sign the admin session cookie
ADMIN_SECRET=change_this_to_a_long_random_string

# --- AI (for the Creator Hub tools) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Optional: live YouTube data for Viral Hashtag tool ---
YOUTUBE_API_KEY=

# --- Optional: create admin via script ---
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your_password
